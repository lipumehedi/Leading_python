#* Break only exits the innermost Loop
for i in range(1, 4):
    for j in range(1, 4):
        if j == 2:
            break
        print(i, j)
#Output: 1 1 2 1 3 1

*Continue

for i in range(1, 4):
    for j in range(1, 4):
         if j == 2:
            continue
         print(i, j)

