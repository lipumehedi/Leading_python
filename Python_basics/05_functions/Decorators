import time

def log_and_time(func):
    def wrapper():
        print("Ranna Shuru")
        start = time.time()
        func()
        end = time.time()
        print("Ranna Shesh")
        elapsed = end - start
        print(f"LOG: finised in {elapsed:.4f}s")
    return wrapper


#-> normal way :

def cook_pasta():
    print("Cooking pasta..")
cook_nasta = log_and_time(cook_pasta)
cook_nasta()

def cook_pizza():
    print("Cooking pizza..")
cook_nizza = log_and_time(cook_pizza)
cook_nizza()

def cook_soup():
    print("Cooking soup....")
cook_toup = log_and_time(cook_soup)
cook_toup()

